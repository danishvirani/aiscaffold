#!/usr/bin/env bash
# {{name}} installer — writes a launcher at ~/.local/bin/{{name}} that runs this
# clone with node. No build step; edits to src/ take effect immediately.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAUNCHER_DIR="${HOME}/.local/bin"
LAUNCHER="${LAUNCHER_DIR}/{{name}}"

if ! command -v node >/dev/null 2>&1; then
  echo "✗ Node.js is not installed. Get it at https://nodejs.org and re-run." >&2
  exit 1
fi

mkdir -p "${LAUNCHER_DIR}"

cat > "${LAUNCHER}" <<EOF
#!/usr/bin/env bash
# auto-generated by {{name}} install.sh
exec node "${REPO_ROOT}/src/cli.js" "\$@"
EOF

chmod +x "${LAUNCHER}"

echo "✓ Installed {{name}} → ${LAUNCHER}"
echo ""

if ! command -v {{name}} >/dev/null 2>&1; then
  echo "⚠ ${LAUNCHER_DIR} is not on your PATH."
  echo "  Add to your shell profile:  export PATH=\"\$HOME/.local/bin:\$PATH\""
  echo ""
fi

echo "Try it:  {{name}} {{command}}"
echo "         {{name}} brief"
