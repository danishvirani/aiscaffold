#!/usr/bin/env bash
# {{name}} installer — writes a launcher at ~/.local/bin/{{name}} pointing at
# this clone. Edits to src/{{package}}/ take effect immediately; no reinstall.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAUNCHER_DIR="${HOME}/.local/bin"
LAUNCHER="${LAUNCHER_DIR}/{{name}}"

mkdir -p "${LAUNCHER_DIR}"

cat > "${LAUNCHER}" <<EOF
#!/usr/bin/env bash
# auto-generated by {{name}} install.sh
exec python3 -c "import sys; sys.path.insert(0, '${REPO_ROOT}/src'); from {{package}}.cli import main; sys.exit(main())" "\$@"
EOF

chmod +x "${LAUNCHER}"

echo "✓ Installed {{name}} → ${LAUNCHER}"
echo ""

if ! command -v {{name}} >/dev/null 2>&1; then
  echo "⚠ ${LAUNCHER_DIR} is not on your PATH."
  echo "  Add to your shell profile:  export PATH=\"\$HOME/.local/bin:\$PATH\""
  echo ""
fi

echo "Try it:  {{name}} {{command}}"
echo "         {{name}} brief"
