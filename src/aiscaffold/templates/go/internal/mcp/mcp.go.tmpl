// Package mcp is a stdlib-only stdio JSON-RPC MCP server for {{name}}.
//
// It speaks newline-delimited JSON-RPC over an io.Reader/io.Writer (the MCP
// stdio transport), handles initialize, tools/list, and tools/call, and
// exposes one tool that mirrors the `{{name}} {{command}}` command.
//
// Add a tool: append to `tools` and add a case to `dispatch`.
package mcp

import (
	"bufio"
	"encoding/json"
	"fmt"
	"io"
	"strings"
)

const (
	protocolVersion = "2025-06-18"
	serverName      = "{{name}}"
	serverVersion   = "0.0.1"
)

type tool struct {
	Name        string         `json:"name"`
	Description string         `json:"description"`
	InputSchema map[string]any `json:"inputSchema"`
}

var tools = []tool{
	{
		Name:        "{{command}}",
		Description: "The example tool — replace with your own logic.",
		InputSchema: map[string]any{
			"type": "object",
			"properties": map[string]any{
				"name": map[string]any{"type": "string", "description": "Who to greet."},
			},
		},
	},
}

// dispatch returns the text result for a tool call. Mirror your CLI here.
func dispatch(name string, args map[string]any) (string, error) {
	switch name {
	case "{{command}}":
		who, _ := args["name"].(string)
		if who == "" {
			who = "world"
		}
		return fmt.Sprintf("Hello, %s, from {{name}}.", who), nil
	}
	return "", fmt.Errorf("unknown tool: %s", name)
}

type request struct {
	JSONRPC string          `json:"jsonrpc"`
	ID      json.RawMessage `json:"id"`
	Method  string          `json:"method"`
	Params  json.RawMessage `json:"params"`
}

func idOrNull(id json.RawMessage) any {
	if len(id) == 0 {
		return nil
	}
	return id
}

func result(id json.RawMessage, res any) map[string]any {
	return map[string]any{"jsonrpc": "2.0", "id": idOrNull(id), "result": res}
}

func errorResp(id json.RawMessage, code int, message string) map[string]any {
	return map[string]any{
		"jsonrpc": "2.0",
		"id":      idOrNull(id),
		"error":   map[string]any{"code": code, "message": message},
	}
}

func marshal(v any) []byte {
	b, _ := json.Marshal(v)
	return b
}

// Handle maps one JSON-RPC request line to a response line. The second return
// is false for notifications (and unparseable lines): write nothing.
func Handle(line []byte) ([]byte, bool) {
	var req request
	if err := json.Unmarshal(line, &req); err != nil {
		return nil, false
	}

	switch req.Method {
	case "initialize":
		return marshal(result(req.ID, map[string]any{
			"protocolVersion": protocolVersion,
			"capabilities":    map[string]any{"tools": map[string]any{}},
			"serverInfo":      map[string]any{"name": serverName, "version": serverVersion},
		})), true
	case "notifications/initialized":
		return nil, false
	case "ping":
		return marshal(result(req.ID, map[string]any{})), true
	case "tools/list":
		return marshal(result(req.ID, map[string]any{"tools": tools})), true
	case "tools/call":
		var p struct {
			Name      string         `json:"name"`
			Arguments map[string]any `json:"arguments"`
		}
		_ = json.Unmarshal(req.Params, &p)
		text, err := dispatch(p.Name, p.Arguments)
		if err != nil {
			return marshal(errorResp(req.ID, -32602, err.Error())), true
		}
		return marshal(result(req.ID, map[string]any{
			"content": []map[string]any{{"type": "text", "text": text}},
		})), true
	}

	if len(req.ID) == 0 || string(req.ID) == "null" {
		return nil, false
	}
	return marshal(errorResp(req.ID, -32601, "method not found: "+req.Method)), true
}

// Serve runs the read-eval-respond loop until the input stream closes.
func Serve(in io.Reader, out io.Writer) int {
	scanner := bufio.NewScanner(in)
	scanner.Buffer(make([]byte, 0, 64*1024), 4*1024*1024)
	for scanner.Scan() {
		line := strings.TrimSpace(scanner.Text())
		if line == "" {
			continue
		}
		if resp, emit := Handle([]byte(line)); emit {
			_, _ = out.Write(append(resp, '\n'))
		}
	}
	return 0
}
