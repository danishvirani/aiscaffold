"""Smoke tests for {{name}}."""

import io
from contextlib import redirect_stdout

import pytest

import {{package}}
from {{package}} import cli


def test_version_constant():
    assert {{package}}.__version__ == "0.0.1"


def test_help_renders():
    parser = cli.build_parser()
    captured = io.StringIO()
    with redirect_stdout(captured):
        with pytest.raises(SystemExit) as exc:
            parser.parse_args(["--help"])
        assert exc.value.code == 0
    out = captured.getvalue()
    assert "{{name}}" in out
    assert "{{command}}" in out
    assert "brief" in out


def test_command_runs():
    captured = io.StringIO()
    with redirect_stdout(captured):
        rc = cli.main(["{{command}}"])
    assert rc == 0
    assert captured.getvalue().strip() != ""


def test_brief_runs():
    captured = io.StringIO()
    with redirect_stdout(captured):
        rc = cli.main(["brief"])
    assert rc == 0
    assert "{{name}}" in captured.getvalue()
{{#if with_mcp}}


def test_mcp_initialize():
    from {{package}} import mcp

    response = mcp.handle({"jsonrpc": "2.0", "id": 1, "method": "initialize"})
    assert response["result"]["serverInfo"]["name"] == "{{name}}"


def test_mcp_tools_list_and_call():
    from {{package}} import mcp

    listed = mcp.handle({"jsonrpc": "2.0", "id": 2, "method": "tools/list"})
    names = [t["name"] for t in listed["result"]["tools"]]
    assert "{{command}}" in names

    called = mcp.handle(
        {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "tools/call",
            "params": {"name": "{{command}}", "arguments": {}},
        }
    )
    assert called["result"]["content"][0]["type"] == "text"
