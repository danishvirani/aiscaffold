#!/usr/bin/env bash
# {{name}} installer — builds a release binary and installs it to
# ~/.local/bin/{{name}}. Re-run after pulling changes to rebuild.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAUNCHER_DIR="${HOME}/.local/bin"

if ! command -v cargo >/dev/null 2>&1; then
  echo "✗ Rust/cargo is not installed. Get it at https://rustup.rs and re-run." >&2
  exit 1
fi

mkdir -p "${LAUNCHER_DIR}"
( cd "${REPO_ROOT}" && cargo build --release )
cp "${REPO_ROOT}/target/release/{{name}}" "${LAUNCHER_DIR}/{{name}}"

echo "✓ Installed {{name}} → ${LAUNCHER_DIR}/{{name}}"
echo ""

if ! command -v {{name}} >/dev/null 2>&1; then
  echo "⚠ ${LAUNCHER_DIR} is not on your PATH."
  echo "  Add to your shell profile:  export PATH=\"\$HOME/.local/bin:\$PATH\""
  echo ""
fi

echo "Try it:  {{name}} {{command}}"
echo "         {{name}} brief"
